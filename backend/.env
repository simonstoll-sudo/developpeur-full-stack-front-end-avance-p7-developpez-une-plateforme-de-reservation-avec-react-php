# Valeurs par défaut de l'API, non secrètes, versionnées (convention Symfony).
# Pour les surcharger, créez un fichier .env.local (ignoré par Git) : ne modifiez pas ce fichier.

# Environnement d'exécution : dev, test ou prod
APP_ENV=dev

# Secret applicatif : à générer dans .env.local avant toute mise en production
APP_SECRET=

# Fichier de données, chemin relatif au dossier backend/
DATA_FILE=../starter-kit/donnees-logements-utilisateurs-kasa.csv

# Origine autorisée pour les appels du front (expression régulière)
CORS_ALLOW_ORIGIN='^https?://localhost:5173$'

# Variables réservées à une évolution de l'API : non lues par le code actuel
JWT_SECRET=
JWT_EXPIRES_IN=1h
BCRYPT_ROUNDS=12
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
